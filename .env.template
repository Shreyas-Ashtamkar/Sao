# Sao Environment Configuration Template
# Copy this file to .env and fill in your values

# --- Application Settings ---

# Define which frontend to launch (options: pyqt, streamlit)
# Default: pyqt
SAO_FRONTEND=streamlit

# --- LLM Provider Credentials ---
# LiteLLM automatically picks up standard environment variables.
# Only fill the keys for the providers you intend to use.

# OpenAI
# OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google (Gemini)
# GEMINI_API_KEY=your-google-api-key-here

# Note: GitHub Copilot authentication is handled interactively via device flow
# or relies on a previously cached token by LiteLLM. No API key is needed here.
