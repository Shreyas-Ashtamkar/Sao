namespace sao.ipc;

enum Role : byte { User = 0, Assistant = 1, System = 2, Tool = 3 }

table ChatMessage {
  role: Role;
  content: string;
}

table ChatRequest {
  session_id: string;
  model_id: string;
  messages: [ChatMessage];
  provider: string;
}

table ChatResponse {
  session_id: string;
  chunk: string;
  is_final: bool;
  tool_calls_json: string;
}

table ListModelsRequest {
  provider: string;
}

table ListModelsResponse {
  provider: string;
  models: [string];
  error: string;
}

rpc_service SaoService {
  ChatStream(ChatRequest): ChatResponse (streaming: "server");
  ListModels(ListModelsRequest): ListModelsResponse;
}
